# Copy to .env and fill in. .env is git-ignored.

# ── Data provider ────────────────────────────────────────────────
# mock   = synthetic ticks, no keys needed, works 24/7 (default)
# alpaca = Alpaca Market Data WebSocket
DATA_PROVIDER=mock

# ── Alpaca (https://app.alpaca.markets → Paper account → API Keys) ──
# Also used for company news in the Dilution window and quote card, even with DATA_PROVIDER=mock.
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# iex  = free plan (IEX exchange only, ~30 symbol limit on trades/quotes)
# sip  = paid plan (all US exchanges — required for accurate volume/RVOL/HOD)
# test = Alpaca's 24/7 test stream; subscribe to the symbol FAKEPACA
ALPACA_FEED=iex
# Use Alpaca's sandbox data host (for broker-API sandbox keys only)
ALPACA_SANDBOX=false
# Paper trading endpoint for the (future) order/REST layer
ALPACA_PAPER=true
# Subscribe to trading statuses (halts / resumptions) for the Halts window.
# Off by default: if your plan doesn't include them, Alpaca rejects the whole subscription.
ALPACA_STATUSES=false
# Market-wide gappers: every ALPACA_MOVERS_REFRESH_SEC, Alpaca's top N % gainers become scanner
# rows. 0 streams WATCHLIST only. On startup, prev close, today's session and ~4 days of
# 1-minute bars are loaded over REST for every symbol, so % change, gap, RVOL and the short
# signals work from the first trade.
ALPACA_MOVERS_TOP=20
ALPACA_MOVERS_REFRESH_SEC=60
# Radar: watch every stock's 1-minute bars (free: bars don't count toward the limit). A stock
# moving ALPACA_RADAR_MOVE_PCT % or more within 5 minutes becomes a row even if it isn't on the
# gainers list, and the live trade slots rotate to whatever is moving hardest. Rows without a
# slot keep updating once a minute from bars. Off = the gainers list only, added until full.
ALPACA_RADAR=true
ALPACA_RADAR_MOVE_PCT=4
# The plan's limit on trade + quote subscriptions (bars don't count): 30 on the free iex feed
# (checked against a real account). Raise it on a paid sip plan.
ALPACA_MAX_SYMBOLS=30
# Bid/ask quotes (spread, quote card). Off by default: on free iex, trades and quotes share the
# 30 limit, so turning quotes on halves the number of streamed symbols.
ALPACA_QUOTES=false

# ── Reference / fundamentals data (future steps: float, short interest, market cap) ──
POLYGON_API_KEY=
FINNHUB_API_KEY=
# SEC EDGAR (free, no key) powers the Dilution window. SEC requires a User-Agent with
# your app name and a contact email, e.g. "DeltaScan you@example.com". Leave empty to disable.
SEC_USER_AGENT=

# ── Symbols streamed at startup (comma-separated) ──
WATCHLIST=AAPL,TSLA,NVDA,AMD,SPY,QQQ,META,AMZN,MSFT,PLTR

# ── Server ──
SERVER_PORT=4000
# How often batched updates are pushed to the UI (ms). Throttles UI load.
BROADCAST_INTERVAL_MS=250
LOG_LEVEL=info

# ── Connection resilience ──
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_TIMEOUT_MS=10000
RECONNECT_BASE_MS=1000
RECONNECT_MAX_MS=30000

# ── Mock provider (streams a built-in ~60-symbol universe; WATCHLIST is ignored) ──
MOCK_TICKS_PER_SECOND=200
# Simulated session progress at startup (0 = 9:30 open, 1 = 16:00 close)
MOCK_SESSION_START=0.35
# Which session to simulate: pre (pre-market), regular, or post (after hours)
MOCK_SESSION=regular
# Length of simulated LULD halts (real ones last 300 s)
MOCK_HALT_SECONDS=90

# ── Storage ──
# SQLite file for accounts, watchlists, saved layouts and alert history (relative to the repo root).
DB_PATH=./data/scanner.db

# ── Accounts & hosting ──
# Require sign-in for the app, its API and the live data socket. Off (local use): one built-in
# account, no login screen. Turn it on before putting the app on the internet.
AUTH_REQUIRED=false
# Let anyone create an account. Off: only the first account can be created (yours); keep it off
# unless your market-data licence allows showing the data to other people.
ALLOW_SIGNUP=false
# Set both when the app runs behind HTTPS through a reverse proxy (see docs/DEPLOY.md).
COOKIE_SECURE=false
TRUST_PROXY=false
# Serve the built web app (npm run build) from the server port: production only.
SERVE_WEB=false
