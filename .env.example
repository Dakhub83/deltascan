# Copy to .env and fill in. .env is git-ignored.

# ── Data provider ────────────────────────────────────────────────
# mock   = synthetic ticks, no keys needed, works 24/7 (default)
# alpaca = Alpaca Market Data WebSocket
DATA_PROVIDER=mock

# ── Alpaca (https://app.alpaca.markets → Paper account → API Keys) ──
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=
# iex  = free plan (IEX exchange only, ~30 symbol limit on trades/quotes)
# sip  = paid plan (all US exchanges — required for accurate volume/RVOL/HOD)
# test = Alpaca's 24/7 test stream; subscribe to the symbol FAKEPACA
ALPACA_FEED=iex
# Use Alpaca's sandbox data host (for broker-API sandbox keys only)
ALPACA_SANDBOX=false
# Paper trading endpoint for the (future) order/REST layer
ALPACA_PAPER=true

# ── Reference / fundamentals data (future steps: float, short interest, market cap) ──
POLYGON_API_KEY=
FINNHUB_API_KEY=

# ── Symbols streamed at startup (comma-separated) ──
WATCHLIST=AAPL,TSLA,NVDA,AMD,SPY,QQQ,META,AMZN,MSFT,PLTR

# ── Server ──
SERVER_PORT=4000
# How often batched updates are pushed to the UI (ms). Throttles UI load.
BROADCAST_INTERVAL_MS=250
LOG_LEVEL=info

# ── Connection resilience ──
HEARTBEAT_INTERVAL_MS=15000
HEARTBEAT_TIMEOUT_MS=10000
RECONNECT_BASE_MS=1000
RECONNECT_MAX_MS=30000

# ── Mock provider (streams a built-in ~60-symbol universe; WATCHLIST is ignored) ──
MOCK_TICKS_PER_SECOND=200
# Simulated session progress at startup (0 = 9:30 open, 1 = 16:00 close)
MOCK_SESSION_START=0.35

# ── Storage ──
DB_PATH=./data/scanner.db
